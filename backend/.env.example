# Cloudinary credentials for Django
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/coursebook
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=

# Google Gemini API (for AI-powered summaries and quizzes)
# Get your free API key from: https://aistudio.google.com/apikey
# Free tier: 1,500 requests per day, 15 requests per minute
GEMINI_API_KEY=your-gemini-api-key-here

